rules_version = '2';

// Security rules for the rhyri app.
//
// Model:
//  - Business collections (invoices, challans, purchaseBills, clients,
//    companies, banks) are per-user: each document carries a `uid` field and is
//    readable/writable only by the user it belongs to.
//  - `users` holds one profile document per account (doc id == uid). A user may
//    read and write only their own profile, but may NOT set the admin-only
//    restriction fields. The admin may read every profile and set restrictions.
//  - The admin (identified by email) may read and write everything. This is
//    what powers the full-database backup/restore in the Admin page.
//
// The admin email mirrors VITE_ADMIN_EMAIL used in the client. It is already
// public (Vite inlines it into the shipped bundle), so keeping it here is not a
// secret leak. If the admin email changes, update it in both places.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'ritaliya2003@gmail.com';
    }

    // The existing document belongs to the caller.
    function ownsExisting() {
      return isSignedIn()
        && resource.data.uid == request.auth.uid;
    }

    // The incoming document is stamped with the caller's own uid.
    function ownsIncoming() {
      return isSignedIn()
        && request.resource.data.uid == request.auth.uid;
    }

    // Shared rules for the per-user business collections.
    function canReadOwned() {
      return ownsExisting() || isAdmin();
    }
    function canCreateOwned() {
      return ownsIncoming() || isAdmin();
    }
    function canUpdateOwned() {
      return (ownsExisting() && ownsIncoming()) || isAdmin();
    }
    function canDeleteOwned() {
      return ownsExisting() || isAdmin();
    }

    match /invoices/{docId} {
      allow read: if canReadOwned();
      allow create: if canCreateOwned();
      allow update: if canUpdateOwned();
      allow delete: if canDeleteOwned();
    }

    match /challans/{docId} {
      allow read: if canReadOwned();
      allow create: if canCreateOwned();
      allow update: if canUpdateOwned();
      allow delete: if canDeleteOwned();
    }

    match /purchaseBills/{docId} {
      allow read: if canReadOwned();
      allow create: if canCreateOwned();
      allow update: if canUpdateOwned();
      allow delete: if canDeleteOwned();
    }

    match /clients/{docId} {
      allow read: if canReadOwned();
      allow create: if canCreateOwned();
      allow update: if canUpdateOwned();
      allow delete: if canDeleteOwned();
    }

    match /companies/{docId} {
      allow read: if canReadOwned();
      allow create: if canCreateOwned();
      allow update: if canUpdateOwned();
      allow delete: if canDeleteOwned();
    }

    match /banks/{docId} {
      allow read: if canReadOwned();
      allow create: if canCreateOwned();
      allow update: if canUpdateOwned();
      allow delete: if canDeleteOwned();
    }

    match /users/{userId} {
      // Admin-only fields that a normal user must never write to themselves.
      function touchesRestriction() {
        return request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['restrictionDate', 'restrictionType']);
      }
      function setsRestrictionOnCreate() {
        return request.resource.data.keys()
          .hasAny(['restrictionDate', 'restrictionType']);
      }
      function isSelf() {
        return isSignedIn() && request.auth.uid == userId;
      }

      allow read: if isSelf() || isAdmin();
      allow create: if isAdmin()
        || (isSelf() && !setsRestrictionOnCreate());
      allow update: if isAdmin()
        || (isSelf() && !touchesRestriction());
      allow delete: if isAdmin();
    }

    // Everything else is denied by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
